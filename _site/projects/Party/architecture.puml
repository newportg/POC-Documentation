@startuml
!include <archimate/Archimate>

title POC Party - Application Architecture

Business_Actor(user, "Party user")

Application_Component(partyApp, "Party browser app")
Application_Component(partyModel, "Party model")
Application_Component(partyApi, "Companies House proxy API")
Application_Component(localMock, "Companies House mock")

Technology_Device(browser, "Browser")
Technology_Service(localStorage, "Browser localStorage")
Technology_SystemSoftware(companiesHouse, "Companies House API")

Rel_Assignment(user, browser)
Rel_Composition(browser, partyApp)
Rel_Serving(partyApp, partyModel)
Rel_Access(partyApp, localStorage)
Rel_Flow(partyApp, localMock)
Rel_Flow(partyApp, partyApi)
Rel_Flow(partyApi, companiesHouse)

note right of partyApi
  Endpoints:
  /health
  /heartbeat
  /api/companies/search
  /docs
  /openapi.json

  The caller's API key is forwarded
  for the request and is not persisted.
end note

@enduml
