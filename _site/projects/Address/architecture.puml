@startuml
!include <archimate/Archimate>

title POC Address - Application Architecture

Business_Actor(user, "Address user")

Application_Component(addressApp, "Address browser app")
Application_Component(addressClient, "Loqate client")
Application_Component(addressApi, "Address proxy API")
Application_Component(cache, "Address response cache")
Application_Component(catalog, "Verified address catalogue")
Application_Component(leaflet, "Leaflet map")

Technology_SystemSoftware(loqate, "Loqate APIs")
Technology_SystemSoftware(osm, "OpenStreetMap tiles")

Technology_Device(browser, "Browser")
Technology_Service(localStorage, "Browser localStorage")

Rel_Assignment(user, browser)
Rel_Composition(browser, addressApp)
Rel_Serving(addressApp, addressClient)
Rel_Access(addressApp, localStorage)
Rel_Serving(addressApp, leaflet)
Rel_Flow(addressClient, addressApi)
Rel_Serving(addressApi, cache)
Rel_Serving(addressApi, catalog)
Rel_Flow(addressApi, loqate)
Rel_Flow(leaflet, osm)

note right of addressApi
  Endpoints:
  /health
  /heartbeat
  /api/addresses/search
  /api/addresses/retrieve
  /api/addresses/catalog

  Cache keys use an API-key fingerprint.
  Cache and catalogue are non-durable.
end note

@enduml
