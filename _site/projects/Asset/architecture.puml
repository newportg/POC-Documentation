@startuml
!include <archimate/Archimate>

title POC Asset - Application Architecture

Business_Actor(user, "Asset user")

Application_Component(assetApp, "Asset browser app")
Application_Component(assetModel, "Asset model")
Application_Component(addressClient, "Address client")
Application_Component(addressApi, "Address proxy API")
Application_Component(leaflet, "Leaflet map")

Technology_Device(browser, "Browser")
Technology_Service(localStorage, "Browser localStorage")
Technology_SystemSoftware(loqate, "Loqate APIs")
Technology_SystemSoftware(osm, "OpenStreetMap tiles")

Rel_Assignment(user, browser)
Rel_Composition(browser, assetApp)
Rel_Serving(assetApp, assetModel)
Rel_Access(assetApp, localStorage)
Rel_Serving(assetApp, addressClient)
Rel_Serving(assetApp, leaflet)
Rel_Flow(addressClient, addressApi)
Rel_Flow(addressApi, loqate)
Rel_Flow(leaflet, osm)

note right of assetApp
  The main application has no
  backend or database.

  Address lookup is optional and
  delegated to the POC Address API.
end note

@enduml
